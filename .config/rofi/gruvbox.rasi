configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "»";
    drun-display-format: "{name} [<span size='small' style='italic'>({generic})</span>]";
    drun-match-fields: "name,generic,exec,categories,keywords";
    matching: "fuzzy";
    sort: true;
    sidebar-mode: false;
    click-to-exit: true;
}

@theme "default"

* {
    bg: #000200;
    fg: #e9d9b6;
    red: #8c3936;
    khaki: #ba9f64;
    selected: #817667;
    background-color: transparent;
    text-color: @fg;
    border-color: @khaki;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 560px;
    border: 0px;
    border-radius: 8px;
    padding: 3px;
    background-color: @bg;
    background-image: linear-gradient(to right, #8c3936, #ba9f64);
    children: [mainbox];
}

mainbox {
    background-color: @bg;
    border: 0px;
    border-radius: 5px;
    padding: 8px;
    spacing: 8px;
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg;
    border: 0px;
    padding: 6px 6px 10px;
    spacing: 8px;
    children: [prompt, entry];
}
prompt { text-color: @khaki; }
entry {
    text-color: @fg;
    placeholder: "";
    cursor: text;
}

listview {
    background-color: @bg;
    border: 0px;
    padding: 0px;
    columns: 1;
    lines: 10;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 2px;
    cycle: true;
    layout: vertical;
}

element {
    background-color: @bg;
    text-color: @fg;
    border: 0px;
    border-radius: 5px;
    padding: 7px 8px;
    spacing: 12px;
    children: [element-icon, element-text];
}
element normal.normal, element alternate.normal {
    background-color: @bg;
    text-color: @fg;
}
element selected.normal, element selected.active, element selected.urgent {
    background-color: @selected;
    text-color: @bg;
}
element normal.active, element alternate.active {
    background-color: @bg;
    text-color: @khaki;
}
element normal.urgent, element alternate.urgent {
    background-color: @bg;
    text-color: #c46b62;
}
element-icon {
    size: 30px;
    background-color: transparent;
    vertical-align: 0.5;
    cursor: inherit;
}
element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold;
    cursor: inherit;
}
