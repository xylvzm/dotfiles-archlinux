* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #89b4fa;

    background-color: @bg;
    text-color: @fg;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 40%;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    padding: 20px;
    location: center;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px;
    children: [ prompt, entry ];
}

listview {
    lines: 6;
    spacing: 6px;
    fixed-height: true;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}
